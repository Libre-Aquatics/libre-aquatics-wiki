{
  "name": "libre-aquatics-wiki",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-links.mjs && astro build",
    "preview": "astro preview",
    "check:copying": "node scripts/check-copying.mjs",
    "manuals:index": "node manuals/_tools/index.mjs",
    "manuals:extract": "node manuals/_tools/extract-text.mjs --apply",
    "manuals:sort": "node manuals/_tools/analyze.mjs --dump && node manuals/_tools/propose.mjs",
    "manuals:undo": "node manuals/_tools/undo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "astro-og-canvas": "^0.13.1",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "gray-matter": "^4.0.3",
    "unist-util-visit": "^5.0.0"
  }
}
