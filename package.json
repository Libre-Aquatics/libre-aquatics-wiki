{
  "name": "libre-aquatics-wiki",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-links.mjs && astro build",
    "preview": "astro preview",
    "check:copying": "node scripts/check-copying.mjs",
    "manuals:index": "node manuals/_tools/index.mjs",
    "manuals:extract": "node manuals/_tools/extract-text.mjs --apply",
    "manuals:sort": "node manuals/_tools/analyze.mjs --dump && node manuals/_tools/propose.mjs",
    "manuals:undo": "node manuals/_tools/undo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^7.1.6",
    "astro-og-canvas": "^0.13.0",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "gray-matter": "^4.0.3",
    "unist-util-visit": "^5.0.0"
  }
}
