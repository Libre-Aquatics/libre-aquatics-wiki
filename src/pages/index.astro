---
// The Main Page: a Wikipedia-style portal. Every list on it is derived at
// build time by src/lib/home.ts from the nav tree, the content collection and
// git history; the only hand-kept content is the curated picks in
// src/data/home.ts, whose paths the link check verifies. No article route is
// typed into this file, so renaming an article cannot leave a dead link here.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadIcon from '../components/LeadIcon.astro';
import { withBase } from '../lib/routes';
import { PAGE_META } from '../lib/seo';
import { buildHome } from '../lib/home';

const home = buildHome(await getCollection('articles'));
const { scope, tagGroups, featured, hooks, photo, portals, pending, recent, added } = home;
---

<BaseLayout title={PAGE_META.home.title} description={PAGE_META.home.description}>
  <main id="content" class="wiki-article mp-main">
    <div class="mp-banner">
      <h1>Libre Aquatics Wiki</h1>
      <p class="mp-tagline">
        A free, open reference for the equipment, timing hardware, software and operations
        behind competitive aquatics.
      </p>
      <form class="mp-search" action={withBase('/search/')} method="get" role="search">
        <label class="mp-visually-hidden" for="mp-search-input">Search the wiki</label>
        <svg class="mp-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5"/></svg>
        <input
          id="mp-search-input"
          class="mp-search__input"
          type="search"
          name="q"
          placeholder="Search the wiki"
          autocomplete="off"
          required
        />
        <button class="mp-search__button" type="submit">Search</button>
      </form>
      <p class="mp-scope">
        {scope.articles} articles on timing consoles, start systems, lane hardware,
        scoreboards, software and file formats, from {scope.companies} companies.
      </p>
    </div>

    {tagGroups.length > 0 && (
      <nav class="mp-tags" aria-labelledby="mp-tags-heading">
        <h2 id="mp-tags-heading" class="mp-visually-hidden">Browse by category</h2>
        {tagGroups.map((group) => (
          <div class="mp-tags__row">
            <span class="mp-tags__label">{group.label}</span>
            <ul class="wiki-tags mp-tags__list">
              {group.tags.map((entry) => (
                <li>
                  <a href={entry.href}>{entry.tag} <span class="mp-count">({entry.count})</span></a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )}

    <div class="mp-columns">
      <div class="mp-col mp-col--a">
        <section class="mp-box mp-featured" aria-labelledby="mp-featured-heading">
          <h2 id="mp-featured-heading">Featured article</h2>
          <div class="mp-box-body">
            {featured.image && (
              <a class="mp-featured__image" href={featured.route} tabindex="-1" aria-hidden="true">
                <img
                  src={withBase(featured.image.src)}
                  alt=""
                  width={featured.image.width}
                  height={featured.image.height}
                  decoding="async"
                />
              </a>
            )}
            <h3><a href={featured.route}>{featured.title}</a></h3>
            <p>{featured.summary}</p>
            <p class="mp-more"><a href={featured.route}>Read the article on {featured.title}</a></p>
          </div>
        </section>
      </div>

      <div class="mp-col mp-col--b">
        <section class="mp-box mp-dyk" aria-labelledby="mp-dyk-heading">
          <h2 id="mp-dyk-heading">Did you know</h2>
          <div class="mp-box-body">
            <ul>
              {hooks.map((parts) => (
                <li>
                  {'... '}{parts.map((part) => (part.route ? <a href={part.route}>{part.text}</a> : part.text))}
                </li>
              ))}
            </ul>
          </div>
        </section>

        {photo && (
          <section class="mp-box mp-photo" aria-labelledby="mp-photo-heading">
            <h2 id="mp-photo-heading">From the photo collection</h2>
            <div class="mp-box-body">
              <figure>
                <a href={photo.route}>
                  <img
                    src={withBase(photo.src)}
                    alt={photo.alt}
                    width={photo.width}
                    height={photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <figcaption>
                  {photo.caption || photo.articleTitle}
                  {' '}From <a href={photo.route}>{photo.articleTitle}</a>.
                  Original photograph, <a href={withBase('/about/credits/')}>credited</a> under CC BY-SA 4.0.
                </figcaption>
              </figure>
            </div>
          </section>
        )}
      </div>

      <div class="mp-col mp-col--c">
        {recent.length > 0 && (
          <section class="mp-box mp-recent" aria-labelledby="mp-recent-heading">
            <h2 id="mp-recent-heading">Recently updated</h2>
            <div class="mp-box-body">
              <ul class="mp-dated">
                {recent.map((entry) => (
                  <li>
                    <a href={entry.route}>{entry.title}</a>
                    <LeadIcon src={entry.image} />
                    <span class="mp-meta">
                      {entry.section && <>{entry.section}, </>}
                      <time datetime={entry.iso}>{entry.shown}</time>
                    </span>
                  </li>
                ))}
              </ul>
              {added.length > 0 && (
                <>
                  <h3>New articles</h3>
                  <ul class="mp-dated">
                    {added.map((entry) => (
                      <li>
                        <a href={entry.route}>{entry.title}</a>
                        <LeadIcon src={entry.image} />
                        <span class="mp-meta">
                          {entry.section && <>{entry.section}, </>}
                          <time datetime={entry.iso}>{entry.shown}</time>
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          </section>
        )}
      </div>
    </div>

    <h2>Browse the wiki</h2>
    <div class="mp-portals">
      {portals.map((portal) => (
        <section class="mp-box mp-portal">
          <h3>
            <a href={portal.href}>{portal.title}</a>
            {' '}<span class="mp-count">({portal.count})</span>
          </h3>
          <div class="mp-box-body">
            <p>{portal.blurb}</p>
            <ul>
              {portal.links.map((link) => (
                <li><a href={link.route}>{link.title}</a></li>
              ))}
            </ul>
            {portal.count > portal.links.length && (
              <p class="mp-more"><a href={portal.href}>All {portal.count} articles</a></p>
            )}
          </div>
        </section>
      ))}
    </div>
    {pending.length > 0 && (
      <p class="mp-pending">
        Sections in preparation, with an outline but no articles yet: {pending.join(', ')}.
      </p>
    )}

    <section class="mp-about" aria-labelledby="mp-about-heading">
      <h2 id="mp-about-heading">About this wiki</h2>
      <div class="mp-about__text">
        <p>
          Each article is built from manufacturer manuals and datasheets, patents,
          governing-body rules and independent reporting, and its claims are cited to those
          sources. Equipment that is no longer sold is covered next to current models,
          since pools keep timing gear running long after it leaves a catalog, and some
          makers have stopped publishing documentation for their older products. How the
          wiki handles sources and images is set out on
          <a href={withBase('/about/sources/')}>Sources and citations</a>.
        </p>
        <p>
          The text is released under CC BY-SA 4.0 and kept as Markdown in a
          <a href="https://github.com/Libre-Aquatics/libre-aquatics-wiki" class="wiki-external">public repository</a>,
          where anyone can suggest a correction or a new article. Photographs of equipment
          are welcome too. The <a href={withBase('/about/')}>about page</a> describes
          the scope and how to contribute.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
