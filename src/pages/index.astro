---
// The Main Page, converted from docs/index.md (a portal page: hero banner
// with search, then four panels of curated links). Matches the old page's
// hide: [navigation, toc] by using BaseLayout directly; the footer link row
// stays, as it did on the old site.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, docPathToRoute } from '../lib/routes';
import { lastUpdated, lastUpdatedISO } from '../lib/gitDates';
import { PAGE_META } from '../lib/seo';

// Recently updated: the same git-derived dates the article footer and the
// sitemap use, so the list cannot drift from what the pages themselves say.
// Articles carry no date in front matter, so git is the only source.
// Pages kept out of search results are kept out of this list too: they are
// section placeholders, and a freshness list should point at the reference
// articles a reader came for.
const articles = await getCollection('articles');
const recent = articles
  .filter((article) => !article.data.noindex)
  .map((article) => ({
    title: article.data.title,
    route: docPathToRoute(`${article.id}.md`),
    iso: lastUpdatedISO(article.filePath),
    shown: lastUpdated(article.filePath),
  }))
  .filter((entry) => entry.iso)
  .sort((a, b) => b.iso.localeCompare(a.iso))
  .slice(0, 8);
---

<BaseLayout title={PAGE_META.home.title} description={PAGE_META.home.description}>
  <main id="content" class="wiki-article mp-main">
    <h1>Libre Aquatics Wiki</h1>

    <div class="mp-banner">
      <h3>Welcome to Libre Aquatics Wiki</h3>
      <p>
        A free, open reference for the equipment, timing hardware, and operations behind
        competitive aquatics, covering swimming, diving, water polo, artistic swimming, and
        open water. It is the reference companion to the
        <a href={withBase('/about/')}>Libre Aquatics project</a>.
      </p>
      <button class="mp-search" type="button" data-mp-search aria-label="Search the wiki" aria-keyshortcuts="/">
        <svg class="mp-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5"/></svg>
        <span class="mp-search__label">Search the wiki</span>
        <kbd class="mp-search__kbd" aria-hidden="true">/</kbd>
      </button>
    </div>

    <div class="mp-grid">
      <div class="mp-box">
        <h2>Equipment</h2>
        <div class="mp-box-body">
          <p>The catalog of hardware used to run aquatic competitions.</p>
          <ul>
            <li><a href={withBase('/equipment/swimming/timers/')}>Timers</a>: swim timing consoles</li>
            <li><a href={withBase('/equipment/swimming/starter/')}>Start systems</a>: starters, speakers, and strobes</li>
            <li><a href={withBase('/equipment/swimming/touchpad/')}>Touchpads</a> and <a href={withBase('/equipment/swimming/semi-automatic/pushbutton/')}>pushbuttons</a>: lane finish hardware</li>
            <li>By sport: <a href={withBase('/equipment/')}>swimming</a>, <a href={withBase('/equipment/diving/')}>diving</a>, <a href={withBase('/equipment/water-polo/')}>water polo</a>, and <a href={withBase('/equipment/common/')}>common gear</a></li>
            <li><a href={withBase('/equipment/')}>All equipment</a>: the full catalog</li>
          </ul>
        </div>
      </div>

      <div class="mp-box">
        <h2>Running a competition</h2>
        <div class="mp-box-body">
          <p>Planning and operating an event.</p>
          <ul>
            <li><a href={withBase('/meet-management/')}>Meet management</a>: entries, seeding, results, and awards</li>
            <li><a href={withBase('/team-management/')}>Team management</a>: clubs, rosters, and entries</li>
            <li><a href={withBase('/software/')}>Software</a>: the Libre Aquatics tools</li>
          </ul>
        </div>
      </div>

      <div class="mp-box">
        <h2>Reference</h2>
        <div class="mp-box-body">
          <p>Background that supports the rest of the wiki.</p>
          <ul>
            <li><a href={withBase('/vendors/')}>Vendors</a>: the companies that make the equipment</li>
            <li><a href={withBase('/categories/')}>Categories</a>: browse every article by sport and topic</li>
          </ul>
        </div>
      </div>

      <div class="mp-box">
        <h2>About</h2>
        <div class="mp-box-body">
          <p>What this wiki is, how it's organized, and how to contribute.</p>
          <ul>
            <li><a href={withBase('/about/')}>About Libre Aquatics Wiki</a>: scope, organization, and contributing</li>
          </ul>
        </div>
      </div>
    </div>

    <h2>What this wiki documents</h2>
    <p>
      Libre Aquatics Wiki is a reference for the hardware that runs a competitive
      aquatics meet: the consoles that keep time, the systems that start races, the
      equipment in each lane that reports a finish, and the software that turns those
      signals into published results. Articles are written from vendor manuals,
      patents, governing-body rules, and independent reporting, and each one cites
      its sources. Discontinued products are covered alongside current ones:
      facilities keep equipment in service long after it leaves a price list, and for
      some older models the manufacturer no longer publishes documentation at all.
    </p>
    <p>
      The timing console is the center of an automatic timing system. This wiki
      documents the Colorado Time Systems
      <a href={withBase('/equipment/swimming/timers/system-5/')}>System 5</a> and
      <a href={withBase('/equipment/swimming/timers/system-6/')}>System 6</a>, and the
      two consoles of the Gen7 platform that replaced them, the
      <a href={withBase('/equipment/swimming/timers/gen7-serial/')}>Gen7 Serial Timer</a>,
      which uses CTS connect-hub deck cabling, and the
      <a href={withBase('/equipment/swimming/timers/gen7-legacy/')}>Gen7 Legacy Timer</a>,
      which drives a facility's existing multi-pin lane harnesses instead. On the
      Daktronics side it covers the
      <a href={withBase('/equipment/swimming/timers/omnisport-1000/')}>OmniSport 1000</a>,
      <a href={withBase('/equipment/swimming/timers/omnisport-6000/')}>OmniSport 6000</a>,
      and the multi-sport
      <a href={withBase('/equipment/swimming/timers/omnisport-2000/')}>OmniSport 2000</a>.
    </p>
    <p>
      Start systems are catalogued by manufacturer and by whether they are portable or
      wired into the deck: the CTS
      <a href={withBase('/equipment/swimming/starter/infinity-pro-start-system/')}>Infinity Pro</a>
      and
      <a href={withBase('/equipment/swimming/starter/championship-elite-start-system/')}>Championship Elite</a>
      lines and their predecessors, the Daktronics
      <a href={withBase('/equipment/swimming/starter/hs-200/')}>HS-200 Horn Start</a>, the
      Swiss Timing
      <a href={withBase('/equipment/swimming/starter/starttime-v/')}>StartTime</a> series
      from the StartTime II to the StartTime V, the
      <a href={withBase('/equipment/swimming/starter/seiko-ps-1400/')}>Seiko PS-1400</a>
      and the rest of the Seiko PS starters, and the portable
      <a href={withBase('/equipment/swimming/starter/swimstart/')}>SWIMSTART</a> and
      <a href={withBase('/equipment/swimming/starter/atlantis/')}>Atlantis</a> systems.
    </p>
    <p>
      Lane hardware has a section for each class of device, with a shared overview
      explaining how that class works and what the rules require, and a page for each
      product:
      <a href={withBase('/equipment/swimming/touchpad/')}>touchpads</a>, including the
      CTS <a href={withBase('/equipment/swimming/touchpad/aquagrip/')}>AquaGrip</a> and the
      Daktronics
      <a href={withBase('/equipment/swimming/touchpad/t-7000/')}>T-7000 series</a>;
      <a href={withBase('/equipment/swimming/semi-automatic/pushbutton/')}>backup pushbuttons</a>;
      <a href={withBase('/equipment/swimming/relay-judging/')}>relay take-off platforms</a>
      that judge exchanges; the
      <a href={withBase('/equipment/swimming/external-speaker/')}>lane speakers</a> that
      carry the starter's commands to every block; and
      <a href={withBase('/equipment/swimming/backstroke-start/')}>backstroke start devices</a>.
      The companies behind all of it have their own
      <a href={withBase('/vendors/')}>vendor pages</a>, and the
      <a href={withBase('/software/')}>software section</a> covers the programs that put
      results on a scoreboard.
    </p>

    {recent.length > 0 && (
      <>
        <h2>Recently updated</h2>
        <ul>
          {recent.map((entry) => (
            <li>
              <a href={entry.route}>{entry.title}</a>, {entry.shown}
            </li>
          ))}
        </ul>
      </>
    )}
  </main>

  <script>
    // The hero button focuses the topbar search input, replacing mp-search.js
    // (which opened Material's search overlay).
    document.querySelector('[data-mp-search]')?.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>('.search input');
      input?.focus();
      input?.scrollIntoView({ block: 'nearest' });
    });
  </script>
</BaseLayout>
