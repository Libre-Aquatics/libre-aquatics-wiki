---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { idToSlug } from '../lib/routes';
import { breadcrumbTrail } from '../lib/navigation';
import { lastUpdated, lastUpdatedISO } from '../lib/gitDates';
import { summarize } from '../lib/seo';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: idToSlug(article.id) },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const { title, description, tags, infoboxTitle, infobox } = article.data;
---

<ArticleLayout
  title={title}
  description={description ?? summarize(article.body)}
  ogKey={idToSlug(article.id)}
  tags={tags}
  infoboxTitle={infoboxTitle}
  infobox={infobox}
  headings={headings}
  entryId={article.id}
  filePath={article.filePath}
  lastUpdated={lastUpdated(article.filePath)}
  modifiedTime={lastUpdatedISO(article.filePath) || undefined}
  breadcrumbs={breadcrumbTrail(article.id)}
>
  <Content />
</ArticleLayout>
