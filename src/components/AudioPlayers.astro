---
// Replaces the browser's own controls on article sound clips with a compact
// player in the wiki's style. Progressive enhancement: the Markdown keeps a plain
// <audio controls>, which is what a reader without JS gets, and this swaps the
// controls for a play button and a progress bar once the page has loaded.
---

<script>
  const PLAY =
    '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>';
  const STOP =
    '<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="9" height="9" fill="currentColor"/></svg>';

  const players: HTMLAudioElement[] = [];

  for (const audio of document.querySelectorAll<HTMLAudioElement>('.wiki-article figure.wiki-figure audio')) {
    const label = audio.getAttribute('aria-label') ?? 'sound clip';

    const player = document.createElement('div');
    player.className = 'wiki-audio';

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'wiki-audio__play';
    button.innerHTML = PLAY;
    button.setAttribute('aria-label', `Play ${label}`);

    // The bar shows how far through the clip playback is. It carries no
    // information the button does not, so it is hidden from assistive tech.
    const track = document.createElement('div');
    track.className = 'wiki-audio__track';
    track.setAttribute('aria-hidden', 'true');
    const fill = document.createElement('div');
    fill.className = 'wiki-audio__fill';
    track.append(fill);

    player.append(button, track);
    audio.removeAttribute('controls');
    audio.hidden = true;
    audio.after(player);
    players.push(audio);

    let frame = 0;
    const draw = () => {
      const share = audio.duration ? audio.currentTime / audio.duration : 0;
      fill.style.transform = `scaleX(${Math.min(share, 1)})`;
      if (!audio.paused) frame = requestAnimationFrame(draw);
    };
    const reset = () => {
      cancelAnimationFrame(frame);
      audio.pause();
      audio.currentTime = 0;
      fill.style.transform = 'scaleX(0)';
      button.innerHTML = PLAY;
      button.setAttribute('aria-label', `Play ${label}`);
      player.classList.remove('is-playing');
    };

    button.addEventListener('click', () => {
      if (!audio.paused) {
        reset();
        return;
      }
      // One clip at a time, so two start tones never sound over each other.
      for (const other of players) if (other !== audio && !other.paused) other.dispatchEvent(new Event('wiki-stop'));
      audio.currentTime = 0;
      audio.play().then(
        () => {
          button.innerHTML = STOP;
          button.setAttribute('aria-label', `Stop ${label}`);
          player.classList.add('is-playing');
          frame = requestAnimationFrame(draw);
        },
        () => reset(),
      );
    });
    audio.addEventListener('ended', reset);
    audio.addEventListener('wiki-stop', reset);
  }
</script>
