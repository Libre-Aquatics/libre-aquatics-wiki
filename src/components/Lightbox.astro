---
// Enlarges a figure's image in place instead of navigating to the asset.
// Progressive enhancement over the plain <a href="/assets/..."> that wraps the
// image: without JS the link still opens the full-size file, which is the
// behaviour this replaces.
---

<div class="lightbox" hidden data-lightbox role="dialog" aria-modal="true" aria-label="Enlarged image">
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close enlarged image">&times;</button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
  </figure>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const closeButton = document.querySelector<HTMLElement>('[data-lightbox-close]');

  if (box && img && caption && closeButton) {
    let opener: HTMLElement | null = null;

    function open(source: string, from: HTMLImageElement, returnFocusTo: HTMLElement) {
      img!.src = source;
      // The article's own alt already describes the picture; reuse it rather
      // than leaving the enlarged copy unlabelled.
      img!.alt = from.getAttribute('alt') ?? '';
      const text = from.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
      caption!.textContent = text;
      caption!.hidden = text === '';

      opener = returnFocusTo;
      box!.hidden = false;
      document.body.classList.add('lightbox-open');
      closeButton!.focus();
    }

    function close() {
      box!.hidden = true;
      img!.src = '';
      document.body.classList.remove('lightbox-open');
      opener?.focus();
      opener = null;
    }

    // Every picture in an article is enlargeable, whether or not its author
    // wrapped it in a link. A wrapped one is preferred because the link is
    // focusable and still opens the asset without JS, but a bare <img> is
    // handled too so a future figure does not silently miss out.
    document.addEventListener('click', (event) => {
      const picture = (event.target as Element | null)?.closest<HTMLImageElement>('.wiki-article img');
      if (!picture) return;
      // Leave modified clicks alone so "open in new tab" still works.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = picture.closest('a');
      if (link) {
        const href = link.getAttribute('href') ?? '';
        // A picture linking somewhere other than its own asset is a real
        // navigation, so leave it be.
        if (!href.startsWith('/assets/')) return;
        event.preventDefault();
        open(href, picture, link);
        return;
      }

      event.preventDefault();
      open(picture.currentSrc || picture.src, picture, picture);
    });

    closeButton.addEventListener('click', close);
    // Clicking the backdrop closes; clicking the picture itself does not.
    box.addEventListener('click', (event) => {
      if (event.target === box) close();
    });
    document.addEventListener('keydown', (event) => {
      if (box.hidden) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      // Keep focus inside the dialog. The close button is its only focusable
      // element, so containment is just refusing to let Tab leave it.
      if (event.key === 'Tab') {
        event.preventDefault();
        closeButton!.focus();
      }
    });
  }
</script>
