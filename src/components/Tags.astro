---
// Category chips under the article title, linking into the Categories index.
import { withBase } from '../lib/routes';
import { tagSlug } from '../lib/tags';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <p class="wiki-tags" data-pagefind-ignore>
      {tags.map((tag) => (
        <a class="wiki-tag" href={withBase(`/categories/#${tagSlug(tag)}`)}>{tag}</a>
      ))}
    </p>
  )
}
